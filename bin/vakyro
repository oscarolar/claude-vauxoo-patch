#!/usr/bin/env python3
"""Vakyro animado en la terminal (Warp o cualquier emulador truecolor).

La animación del patch de Claude Code migrada a ANSI art: cicla los 4
estados pensar → escribir → leer → trabajar, igual que el indicador del
webview. Frames pre-renderizados desde los SVG oficiales (bin/frames.json).

Uso:
  vakyro              ciclo infinito (Ctrl+C para salir)
  vakyro --once       un ciclo completo y termina
  vakyro --frame N    imprime el estado N (0-3) estático y sale
"""
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
FRAMES = json.load(open(os.path.join(HERE, "frames.json")))
ORDER = ["think", "write", "read", "work"]
VERBS = {
    "think": ("Pensando…", (228, 169, 0)),
    "write": ("Escribiendo…", (228, 169, 0)),
    "read": ("Leyendo…", (172, 3, 64)),
    "work": ("Trabajando…", (84, 152, 204)),
}
HOLD = 1.5


def show(state, bob=0):
    lines = FRAMES[state]
    pad = " " * (2 + bob)
    out = ["\x1b[0m" + ("" if bob else "")]
    for ln in lines:
        out.append(pad + ln)
    verb, (r, g, b) = VERBS[state]
    out.append("\x1b[0m")
    out.append(f"   \x1b[1m\x1b[38;2;{r};{g};{b}m❖ {verb}\x1b[0m")
    sys.stdout.write("\n".join(out) + "\n")
    sys.stdout.flush()
    return len(lines) + 3


def main():
    args = sys.argv[1:]
    if args and args[0] == "--frame":
        show(ORDER[int(args[1]) % 4])
        return
    once = bool(args and args[0] == "--once")
    sys.stdout.write("\x1b[?25l")  # ocultar cursor
    rows = 0
    try:
        cycle = 0
        while True:
            for state in ORDER:
                for bob in (0, 1, 0, 1):  # balanceo horizontal sutil
                    if rows:
                        sys.stdout.write(f"\x1b[{rows}A")
                    rows = show(state, bob)
                    time.sleep(HOLD / 4)
            cycle += 1
            if once and cycle >= 1:
                break
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[?25h\x1b[0m\n")


if __name__ == "__main__":
    main()
